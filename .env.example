# VITE-first alignment: the client talks to Supabase directly, so any server
# code (diagnostics, breach tests) verifies against the SAME vars the client
# bundles. Never diverge these.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...            # role claim MUST decode to "anon"

# Server-only. Never prefixed with VITE_ — that would bundle it into the client.
# Optional: only the /api/env-check diagnostic and scripts/e2e/gate-breach.mjs
# use it. The app itself never needs the service key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # role claim MUST decode to "service_role"

# Local dev with NO env at all also works: the gate enters "offline preview"
# mode (accepts anything, logs nothing, clearly badged). Production builds with
# missing env fail closed — a config error screen, not an open gate.
