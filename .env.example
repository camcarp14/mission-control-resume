# VITE-first alignment: the client mints the tokens, so functions verify against
# the SAME vars the client bundles. Never diverge these two projects.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...            # role claim MUST decode to "anon"

# Server-only. Never prefixed with VITE_ — that would bundle it into the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # role claim MUST decode to "service_role"
ANTHROPIC_API_KEY=sk-ant-...             # scheduler function only; never client-side

# Single-user app: the one account allowed to hold data. Set after first signup.
BUILDOUT_OWNER_EMAIL=you@example.com
